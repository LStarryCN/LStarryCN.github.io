  "private": true,
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "predev": "node scripts/generate-search-index.mjs && node scripts/optimize-images.mjs",
    "dev": "next dev",
