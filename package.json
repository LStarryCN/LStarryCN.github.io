    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^20.19.17",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "postcss": "^8.5.6",
    "sharp": "^0.35.4",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "^5.9.2"
  }
